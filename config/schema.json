{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "native_language": {
      "type": "string",
      "minLength": 1
    },
    "target_language": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "self_reported": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "self_reported",
        "goal"
      ]
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_minutes": {
          "enum": [
            15,
            30
          ]
        },
        "preferred_time": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "auto",
            "text",
            "voice"
          ]
        }
      },
      "required": [
        "default_minutes",
        "preferred_time",
        "timezone",
        "mode"
      ]
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "enum": [
            "precise",
            "supportive"
          ]
        },
        "automatic_praise": {
          "const": false
        },
        "explanation_language": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "style",
        "automatic_praise",
        "explanation_language"
      ]
    },
    "notion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "destination": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "require_explicit_write_approval": {
          "const": true
        }
      },
      "required": [
        "enabled",
        "destination",
        "require_explicit_write_approval"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "life",
        "work"
      ],
      "properties": {
        "life": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "life": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "work": {
              "minItems": 1
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "native_language",
    "target_language",
    "level",
    "goals",
    "interests",
    "session",
    "feedback",
    "context"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adaptive Language Coach configuration",
  "allOf": [
    {
      "if": {
        "required": [
          "notion"
        ],
        "properties": {
          "notion": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "notion": {
            "properties": {
              "destination": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
